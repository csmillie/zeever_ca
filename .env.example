# Database
DATABASE_URL=postgresql://zeever:zeever@localhost:5432/zeever

# LLM Providers
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=        # Fireworks.ai (required for Nomic Embed v1.5 embeddings)
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Fireworks Model Options (uncomment one):
FIREWORKS_MODEL=accounts/fireworks/models/qwen2p5-7b-instruct

# Embeddings. Tried in order; the first endpoint that answers wins, and
# Fireworks is only reached when the self-hosted ones do not. Leave the first
# two blank to keep the previous behaviour of embedding entirely through
# Fireworks.
#
# All three run nomic-embed-text-v1.5, so their vectors are interchangeable
# (measured agreement: cosine 0.99999). Ollama knows the weights by a shorter
# name, which is what EMBEDDING_MODEL is for.
#
# Ollama truncates input at 2,048 tokens and says nothing about it, so the
# chunker caps chunks below that and the embedder refuses anything larger
# rather than storing a vector for text that was silently cut.
# NOTE: no trailing comments on these two lines. dotenv strips them, PM2 does
# not, so a URL written as `http://host:11434/v1  # NVIDIA` works when tested
# locally and 404s in production -- which then falls through to the paid
# provider silently, because the chain is designed to survive exactly that.
# Examples go above the line, never beside it.
#
#   EMBEDDING_BASE_URL=http://HOST_2_TAILNET_IP:11434/v1
#   EMBEDDING_BASE_URL_2=http://HOST_1_TAILNET_IP:11434/v1
EMBEDDING_BASE_URL=
EMBEDDING_BASE_URL_2=
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=ollama     # Ollama ignores it; the OpenAI SDK requires one

# How much the application says about itself. INFO emits retrieval timings,
# which model answered and what it cost; WARNING emits only problems.
#
# Raising this does NOT start logging what people asked. The loggers that carry
# question text are pinned to WARNING in api.py regardless of this setting,
# because keeping a record of residents' questions is a privacy decision rather
# than a logging one.
LOG_LEVEL=INFO
# Together.ai (alternative inference provider, same OpenAI-compatible API)
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
# Qwen3.5-9B: $0.17/$0.25 per 1M tokens, 262K context.
# Replaced Qwen/Qwen2.5-7B-Instruct-Turbo on 2026-08-26, which Together moved off
# serverless (still listed, but dedicated-endpoint only, so calls return HTTP 400).
# This is a reasoning model: TogetherProvider disables thinking automatically, or it
# returns empty content. Other verified-serverless options: openai/gpt-oss-20b,
# openai/gpt-oss-120b, meta-llama/Llama-3.3-70B-Instruct-Turbo.
TOGETHER_MODEL=Qwen/Qwen3.5-9B
# Augure (sovereign Canadian provider, OpenAI-compatible; benchmark-only for now).
# Requests enter via Augure's gateway in Beauharnois, QC; inference in Canada and
# vetted EU partners under zero retention, never US providers. API keys are issued
# through a gated application process at https://chat.augureai.ca/developers/dashboard
# NOTE: rates are published in CAD per 1M tokens, unlike every other provider here.
# NOTE: production/customer-facing use requires displaying "Powered by Augure" per
# their brand terms — benchmarking does not, but shipping it in the chat UI would.
AUGURE_API_KEY=
AUGURE_BASE_URL=https://api.augureai.ca/v1
AUGURE_MODEL=ossington-5

# OVHcloud AI Endpoints (free tier, no API key required)
OVH_API_KEY=none
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_MODEL=Qwen3-32B
# Cohere (proprietary — benchmark/eval only, OpenAI-compatible endpoint)
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.ai/compatibility/v1
COHERE_MODEL=command-a-03-2025
# Turbopuffer (retrieval experiment — Toronto region for data residency)
# Empty disables Turbopuffer entirely: no dual-write, no vector deletes on
# re-crawl, and a clear error from anything that still asks for it rather than a
# 401 from the API. Turning it back on is the same line. While it is off the
# namespace goes stale and has to be rebuilt before it could serve again:
#   uv run python scripts/rebuild_turbopuffer.py --namespace <new> --verify
TURBOPUFFER_API_KEY=
TURBOPUFFER_REGION=gcp-northamerica-northeast2
TURBOPUFFER_NAMESPACE=toronto-chunks
# Retrieval backend for production reads: pgvector (default) | turbopuffer
RETRIEVAL_BACKEND=pgvector

# How much of the ivfflat index a pgvector query reads: this many lists out of the
# 240 the index is built with. Read by the production retriever, not only by the
# benchmark.
#
# Swept over the 300-page breadth eval, against an exact sequential scan at 58.3%
# and 295ms:
#
#   probes   recall   p50    p95
#       10    53.0%   37ms   85ms
#       20    55.1%   36ms   65ms
#       40    57.1%   35ms  128ms
#       80    57.8%   67ms  117ms
#
# 40 is the knee: 3 pages of 295 short of exhaustive search (McNemar p=0.45) at a
# tenth of the latency. It only means anything against the index's lists, so
# re-run scripts/sweep_probes.sh if the index is rebuilt (db/migrations/005).
IVFFLAT_PROBES=40

# Benchmark only. Points the pgvectorscale arm of the retrieval comparison at a
# separate database carrying a StreamingDiskANN index, so pgvector, pgvectorscale
# and Turbopuffer can be scored on the same questions.
#
# Left empty on purpose. The arm refuses to run without it rather than falling
# back to the app's database, because that fallback would benchmark production and
# report the result as pgvectorscale. It is never read by the production
# retriever, only by scripts/setup_pgvectorscale.py and the experiment harness.
#
#   postgresql://USER:PASSWORD@BENCHMARK_HOST:5432/canadianai
PGVECTORSCALE_DATABASE_URL=

# Query-time accuracy knob for that arm. Empty leaves the extension's default,
# which is what an out-of-the-box comparison should measure.
PGVECTORSCALE_QUERY_RESCORE=
# vector (dense only, default) | hybrid (dense + BM25 fused with RRF).
# Turbopuffer only, since it is the backend with a lexical index. Dense search has
# no way to insist that a term in the question appears in the chunk: "How do I set
# up a new water account" is dominated by "set up a new account", which is how a
# parks-recreation registration page outranked every water chunk and took two of
# the five context slots. BM25 anchors the word "water".
RETRIEVAL_MODE=vector
# How many chunks one page may contribute to a single answer. Swept over the 100
# benchmark prompts: 89 hits at 1, 88 at 2, 87 at 3, nothing lost by tightening.
# Raise it only with a sweep to justify it:
#   uv run python scripts/compare_retrieval_modes.py --max-per-url 1 2 3 --modes vector
MAX_CHUNKS_PER_URL=1

# Skip PDFs that are reference or archive material rather than resident answers:
# council agendas and decisions, engineering specifications, municipal code,
# infrastructure project appendices. Measured over a 295-page sample they retrieve
# at 39 percent against 73 for resident-facing PDFs, and council papers alone at
# 15. Off by default, because turning it on changes what the corpus contains and
# that should follow a before-and-after rather than an argument:
#   uv run python scripts/audit_pdf_corpus.py --urls-out resident.txt --only resident
#   uv run python scripts/eval_retrieval_breadth.py --urls resident.txt --questions q.json
EXCLUDE_REFERENCE_PDFS=false

# Skip PDFs that are the same document republished in another language. They
# measure 0 percent recall, and not because they are poor: an English query cannot
# match a Punjabi article, so they are unreachable by construction while still
# costing embedding, storage and a slot beside the English original. Off by
# default because this is a product decision. Supporting the languages properly,
# by detecting the query language and answering in it, would be the better answer
# than dropping them, and is a feature rather than a setting.
# To remove the ones already indexed:
#   uv run python scripts/prune_reference_pdfs.py --group translated --apply
EXCLUDE_TRANSLATED_PDFS=false
# Ollama (self-hosted, no API key needed — set base URL to enable).
# Setting this makes Ollama the highest-priority serving provider, and is also what
# enables the local models in scripts/compare_models.py. For a box on the LAN use
# its address rather than localhost, e.g. http://192.168.1.50:11434/v1
#
# The app speaks the OpenAI request format, which Ollama serves under /v1. The bare
# host also works — the provider appends /v1 and will not double it — but writing
# it here keeps the config honest about which of Ollama's two APIs is in use. Do
# not point this at /api/chat: that is the native API and takes a different request
# shape.
# Required for /a2a and /api/mcp to work at all.
#
# Those two endpoints pin every request to self-hosted inference
# (provider="local"), so with no Ollama host configured they return 503 rather
# than falling back to a paid provider. That is deliberate: both treat a missing
# API key as "no auth required", so anything that can reach them could otherwise
# run up a metered bill nobody chose to spend. The website is unaffected and
# keeps the full provider chain.
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct
# Ollama ignores the key; the OpenAI SDK requires a non-empty one.
OLLAMA_API_KEY=ollama
# Sent as `reasoning_effort` on /v1/chat/completions, and only to models that
# reason (gpt-oss). "low" gets to the visible answer soonest; "medium" and "high"
# buy accuracy on harder questions at a real latency cost. Models that can switch
# reasoning off entirely (qwen3, qwq, deepseek-r1) get "none" regardless.
OLLAMA_REASONING_EFFORT=low

# System prompt: grounded (default) | v1. "grounded" promotes the evidence rule and
# tells the model that recognising an answer from training does not make it
# evidence. A/B over three models: confident+ answers — confident, unsupported by
# the sources — fell from 7 to 2, and both-low fell too, so it was not bought with
# refusals. Expect judge_relevance to read lower under it; that metric scores
# "the evidence does not cover this" at zero.
SYSTEM_PROMPT_VARIANT=grounded

# Keep models resident so a request does not pay to load them. Ollama unloads
# after 5 minutes by default, which on a low-traffic site means most queries hit a
# cold model: loading gpt-oss:20b took 21.9s in one benchmark run. Set
# OLLAMA_KEEP_ALIVE=-1 on the Ollama host itself (systemd override, not here) to
# keep the model loaded indefinitely. VRAM is the trade: a resident model holds
# its memory, and two large models will not both fit on a 20GB card.

# Second Ollama host, tried after the first in the failover chain and available to
# the benchmark as the "ollama2" provider.
OLLAMA_BASE_URL_2=
OLLAMA_MODEL_2=

# Ceiling on generated tokens, not the context window. Answers here are meant to be
# two to four short paragraphs; left unbounded a model will happily produce far
# more. One 79-token request generated 3,512 output tokens, roughly 31 seconds at
# 112 tok/s. Raise it if you need longer answers.
LLM_MAX_OUTPUT_TOKENS=800

# Langfuse (optional, for tracing and observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Deploy webhook
DEPLOY_WEBHOOK_SECRET=           # GitHub webhook secret (optional but recommended)

# Admin dashboard
ADMIN_PASSWORD=                  # Password for /admin section

# Crawl
CRAWL_RATE_LIMIT_MS=1000
# Quoted because of the parentheses and semicolon. python-dotenv strips the
# quotes, and without them the file cannot be read by `. ./.env` in a shell:
# bash stops at the "(" and every line below this one is silently skipped.
CRAWL_USER_AGENT="Zeever/0.1 (toronto-services-research; contact@zeever.ca)"

# Web app runtime
# These are read by the Next.js process, not by the Python side. The deploy
# copies exactly these three keys out of this file and into the unpacked
# runtime as apps/web/.env, mode 600. Nothing else from this file goes there:
# the web app talks to the FastAPI service over HTTP and never touches
# Postgres or a model provider, so it has no use for those secrets.
#
# A key that is absent here but present in the PM2 config is accepted; a key
# that is absent from both fails the deploy.
API_URL=http://127.0.0.1:3034   # Where the FastAPI service listens
# Bearer tokens for the two machine-facing endpoints, /a2a and /api/mcp.
#
# These are not optional in practice. checkApiKey() and checkMcpApiKey() both
# return true when their key is unset, so an empty value does not lock the
# endpoint down, it opens it to everyone. The deploy refuses to ship a runtime
# that has neither of them, because "unauthenticated" and "healthy" look
# identical from outside.
#
# Empty counts as unset. The deploy tests the value, not the presence of the
# line, so leaving these exactly as they ship here fails the deploy rather than
# quietly publishing an open endpoint.
A2A_API_KEY=
MCP_API_KEY=

# Deploy: fetching the CI-built web runtime
# The Next.js build runs in GitHub Actions and the deploy downloads the result.
# A clean build peaks near 2GB across its process tree, which this 4GB box
# cannot spend without restarting the neighbouring PM2 apps.
#
# Fine-grained PAT, scoped to this repository, with Actions: read-only. It is
# used to find the workflow run for the commit being deployed, to refuse a
# commit whose build failed, and to download the artifact. Read-only on Actions
# is the whole permission set: it cannot push, merge, or start a workflow.
DEPLOY_GITHUB_TOKEN=
DEPLOY_GITHUB_REPO=csmillie/zeever_ca
# Seconds to wait for an in-progress CI build before giving up. The deploy
# webhook and the CI run both start from the same push, so a deploy normally
# spends a minute or two here waiting for the build it is going to download.
DEPLOY_FETCH_TIMEOUT=900
# Failure alerts
# When a deploy fails, the tail of .deploy.log is emailed here via the local MTA
# (Postfix on this box). Unset means no email is sent — the deploy says so in
# its own log rather than staying quiet about it.
#
# Credentials are stripped from the log before sending. That is not optional:
# on 2026-09-14 pydantic printed a GitHub PAT and two API keys into that log
# while reporting a validation error, and mailing it unfiltered would have
# forwarded them off the box.
#
# Deliverability from a VPS IP is the weak point. Send yourself a test failure
# before trusting it, and check spam.
DEPLOY_ALERT_EMAIL=
DEPLOY_ALERT_FROM=deploy@zeever.ca
DEPLOY_SENDMAIL=/usr/sbin/sendmail

# Escape hatch: build on the box instead of fetching. For when CI is
# unreachable and the site has to ship anyway. Not a mode to leave switched on.
DEPLOY_ALLOW_LOCAL_BUILD=
# Node heap ceiling for that escape-hatch build only, in MB. Large enough for
# the TypeScript check to finish, small enough that the box survives it.
DEPLOY_BUILD_HEAP_MB=768
