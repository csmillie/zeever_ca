# Database
DATABASE_URL=postgresql://canadianai:canadianai@localhost:5432/canadianai

# LLM Providers
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=        # Fireworks.ai (required for Nomic Embed v1.5 embeddings)
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Fireworks Model Options (uncomment one):
FIREWORKS_MODEL=accounts/fireworks/models/qwen3-8b
# Together.ai (alternative inference provider, same OpenAI-compatible API)
TOGETHER_API_KEY=
TOGETHER_BASE_URL=https://api.together.xyz/v1
TOGETHER_MODEL=Qwen/Qwen2.5-7B-Instruct-Turbo
# OVHcloud AI Endpoints (free tier, no API key required)
OVH_API_KEY=none
OVH_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
OVH_MODEL=Qwen3-32B
# Ollama (self-hosted, no API key needed — set base URL to enable)
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen2.5:7b-instruct

# Langfuse (optional, for tracing and observability)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Deploy webhook
DEPLOY_WEBHOOK_SECRET=           # GitHub webhook secret (optional but recommended)

# Admin dashboard
ADMIN_PASSWORD=                  # Password for /admin section

# Crawl
CRAWL_RATE_LIMIT_MS=1000
CRAWL_USER_AGENT=CanadianAI/0.1 (toronto-services-research; contact@canadianai.ca)
