# Python
__pycache__/
*.pyc
.venv/
*.egg-info/
dist/
.mypy_cache/

# Node
node_modules/
.next/
.turbo/

# Environment
.env
.env.local

# Backups made before editing a live .env, e.g. .env.bak-1790002290. These hold
# real credentials -- the same ones .env is ignored for -- and a deploy runs in
# this directory, so an untracked one sitting here is one `git add -A` away from
# being committed.
.env.bak*
.env.*.bak
.env.backup*

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store

# Benchmark and eval outputs. Every run writes a few hundred KB here, including
# on the VPS, where the deploy does `git pull` in this same working tree. A
# generated file landing on a path a future commit also uses would break a
# deploy, and the deploy that matters is the one nobody is watching.
evals/*.csv
evals/*.json

# Written into the repo root by the detached deploy so its result survives a
# restart of the webhook that started it.
.deploy-status.json
.deploy.log

# Data
*.pdf
data/raw/
.gitnexus
_review-bench/

# Rendered video. Not in history: an 11 MB MP4 is committed once and
# re-downloaded by every clone forever, including the VPS working tree the
# deploy pulls into. No page embeds it, and neither the recording script nor
# its captions are in the repo.
apps/web/public/videos/*.mp4

# The web runtime, built by GitHub Actions and unpacked here by the deploy.
# `.runtime` is a symlink to the current `.runtime-<sha>`; the previous
# generation is kept beside it so a rollback is one rename and so a browser
# still holding the old HTML can fetch its old, content-hashed chunks.
.runtime
.runtime-*
# Where the artifact zip is unpacked and checksummed before it is trusted.
.deploy-scratch
# Held for the duration of a deploy so two cannot interleave.
.deploy.lock
# A push that arrived mid-deploy, waiting for the next one.
.deploy-pending

# Generated by next dev/build; its contents vary with the Next version.
apps/web/next-env.d.ts

# Private / deployment
.claude/
CLAUDE.md
AGENTS.md
ecosystem.config.js
docs/superpowers/
experiments/runs/
